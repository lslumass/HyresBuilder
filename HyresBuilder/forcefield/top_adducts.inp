* topology file for HyRes amino acid adducts and modified residues
* (e.g. fluorescent dyes attached to Cys or to an RNA end). Protein residues
* keep backbone N, H, CA, C, O as in top_hyres_mix.inp; RNA end residues bond
* to the P / C1 beads of top_RNA_mix.inp.
* Load together with top_hyres_mix.inp (backbone and side-chain types),
* top_RNA_mix.inp (RP, RS1, RS2) and top_metabolome.inp (M03, M05, M06, M07,
* MSO); utils.load_ff('Adduct').
* New residue names must also be added to GenPsf.aas (protein) or GenPsf.rnas (RNA).
*
   20    1

!## dye bead types
!## dye xanthene centre (A48 A11, A59 A10); own type so stacking can be set by NBFIX
MASS   244 XAN   36.033   ! xanthene C9 + C8a + C9a (C3)
MASS   245 XAR   26.038   ! dye aromatic ring bead (phenyl and uncharged xanthene beads), as A4H


DECL -C
DECL -O
DECL +N
DECL +H
DECL +CA
DECL +EO
DECL -EO
DECL +P
DECL +C1
DECL +C2
DECL -P
DECL -C1
DECL -C2

AUTOGENERATE DIHE
DEFA FIRS NTER LAST CTER

!## Alexa Fluor 488 C5-maleimide attached to Cys (Cys part identical to RESI CYS)
!## dye beads A01-A18 follow the numbering of the A488 mapping figure (there is no A10); HyRes bead types:
!##   A01,A02 M07 imide C(=O) | A03 C3E N-CH2 | A04 A2V (CH2)3 | A05 M03 CH2-NH-C(=O)
!##   A06,A07,A08 XAR phenyl | A09 QaD COO(-) | A11 XAN xanthene C9 (stacking) | A12,A18 XAR CH=CH
!##   A13,A16 P1W C-NH2 (+0.5 each) | A14,A17 MSO C-SO3(-) | A15 XAR C-O-C
!##   M07, M03 and MSO are metabolome types (top_metabolome.inp)
RESI A48    -2.00000
GROU
ATOM N    NH1     0.00
ATOM H    H       0.00
ATOM CA   C1E     0.00
GROU
ATOM CB   P1C     0.00
GROU
ATOM A01  M07     0.00
ATOM A02  M07     0.00
ATOM A03  C3E     0.00
ATOM A04  A2V     0.00
ATOM A05  M03     0.00
GROU
ATOM A06  XAR     0.00
ATOM A07  XAR     0.00
ATOM A08  XAR     0.00
ATOM A09  QaD    -1.00
GROU
ATOM A11  XAN     0.00
ATOM A12  XAR     0.00
ATOM A13  P1W     0.50
ATOM A14  MSO    -1.00
ATOM A15  XAR     0.00
ATOM A16  P1W     0.50
ATOM A17  MSO    -1.00
ATOM A18  XAR     0.00
GROU
ATOM C    C       0.00
ATOM O    O       0.00
BOND N    CA        CA   C         C    +N        C    O         N    H
BOND CA   CB
! dye: succinimide ring, linker, phenyl ring
BOND CB   A01       A01  A02       A01  A03       A02  A03       A03  A04
BOND A04  A05       A05  A06       A06  A07       A06  A08       A07  A08
BOND A07  A09       A08  A11
! dye: xanthene, left ring A11-A12-A13-A14-A15, right ring A11-A18-A16-A17-A15, triangulated through A15
BOND A11  A12       A12  A13       A13  A14       A14  A15       A11  A15
BOND A12  A15       A13  A15
BOND A11  A18       A18  A16       A16  A17       A17  A15       A18  A15
BOND A16  A15
ANGL -C   N    H         -C   N    CA         H    N    CA
ANGL N    CA   C          C    CA   CB
ANGL CA   C    O         CA   C    +N         O    C    +N
! dye: linker angles (fitted); none inside the rigid phenyl + xanthene
ANGL CB   A01  A02       A02  A03  A04       A03  A04  A05       A04  A05  A06
ANGL A05  A06  A08
! dihedrals inside this residue come only from these DIHE lines (no auto generation):
! Cys part, as generated for CYS
DIHE H    N    CA   C         N    CA   C    O         CB   CA   C    O
! dye: linker dihedrals (fitted)
DIHE CB   A01  A02  A03       A01  A02  A03  A04       A01  A03  A04  A05
DIHE A03  A04  A05  A06       A04  A05  A06  A08       A05  A06  A08  A07
IMPH N    -C   CA   H         C    CA   +N   O         CA   N    C    CB
CMAP -C   N    CA   C         N    CA   C    +N


!## Alexa Fluor 594 C5-maleimide attached to Cys (Cys part identical to RESI CYS)
!## dye beads A01-A23 follow the numbering of the A594 mapping figure; HyRes bead types:
!##   A01,A02 M07 imide C(=O) | A03 C3E N-CH2 | A04 A2V (CH2)3 | A05 M03 CH2-NH-C(=O)
!##   A06,A07,A08 XAR phenyl | A09 QaD COO(-) | A10 XAN xanthene C9 (stacking) | A11,A23 XAR ring C2H
!##   A16,A18 XAR ring C2 next to N | A17 XAR C-O-C | A15,A19 M06 N(+)-CH3 (+0.5 each)
!##   A14,A20 A2V C(CH3)2 | A12,A21 A2Y C=CH | A13,A22 MSO CH2-SO3(-)
!##   M07, M03, M06 and MSO are metabolome types (top_metabolome.inp)
RESI A59    -2.00000
GROU
ATOM N    NH1     0.00
ATOM H    H       0.00
ATOM CA   C1E     0.00
GROU
ATOM CB   P1C     0.00
GROU
ATOM A01  M07     0.00
ATOM A02  M07     0.00
ATOM A03  C3E     0.00
ATOM A04  A2V     0.00
ATOM A05  M03     0.00
GROU
ATOM A06  XAR     0.00
ATOM A07  XAR     0.00
ATOM A08  XAR     0.00
ATOM A09  QaD    -1.00
GROU
ATOM A10  XAN     0.00
ATOM A11  XAR     0.00
ATOM A12  A2Y     0.00
ATOM A13  MSO    -1.00
ATOM A14  A2V     0.00
ATOM A15  M06     0.50
ATOM A16  XAR     0.00
ATOM A17  XAR     0.00
ATOM A18  XAR     0.00
ATOM A19  M06     0.50
ATOM A20  A2V     0.00
ATOM A21  A2Y     0.00
ATOM A22  MSO    -1.00
ATOM A23  XAR     0.00
GROU
ATOM C    C       0.00
ATOM O    O       0.00
BOND N    CA        CA   C         C    +N        C    O         N    H
BOND CA   CB
! dye: succinimide ring, linker, phenyl ring
BOND CB   A01       A01  A02       A01  A03       A02  A03       A03  A04
BOND A04  A05       A05  A06       A06  A07       A06  A08       A07  A08
BOND A07  A09       A08  A10
! dye: xanthene, inner ring A10-A11-A16-A17-A18-A23, triangulated through A17
BOND A10  A11       A11  A16       A16  A17       A17  A18       A18  A23
BOND A23  A10       A10  A17       A11  A17       A23  A17
! dye: left outer ring A11-A12-A14-A15-A16, right outer ring A23-A21-A20-A19-A18
BOND A11  A12       A12  A14       A14  A15       A15  A16       A12  A16
BOND A14  A16       A12  A13
BOND A23  A21       A21  A20       A20  A19       A19  A18       A21  A18
BOND A20  A18       A21  A22
ANGL -C   N    H         -C   N    CA         H    N    CA
ANGL N    CA   C          C    CA   CB
ANGL CA   C    O         CA   C    +N         O    C    +N
! dye: linker angles (fitted); none inside the rigid phenyl + xanthene
ANGL CB   A01  A02       A02  A03  A04       A03  A04  A05       A04  A05  A06
ANGL A05  A06  A08
! dihedrals inside this residue come only from these DIHE lines (no auto generation):
! Cys part, as generated for CYS
DIHE H    N    CA   C         N    CA   C    O         CB   CA   C    O
! dye: linker dihedrals (fitted)
DIHE CB   A01  A02  A03       A01  A02  A03  A04       A01  A03  A04  A05
DIHE A03  A04  A05  A06       A04  A05  A06  A08       A05  A06  A08  A07
IMPH N    -C   CA   H         C    CA   +N   O         CA   N    C    CB
CMAP -C   N    CA   C         N    CA   C    +N

!## 5'-Alexa Fluor 594 on RNA: dye-NH-(CH2)5-succinimide-S-(CH2)6-O-P(5') of the first nucleotide.
!## The 5' phosphate (P, O-(CH2)6 oxygen included) is the P bead of the next (first RNA) residue.
!## A01-A23 are the beads of RESI A59 (same types, charges and dye bonds); the Cys CB is replaced by
!##   L2 A5M S-(CH2)3 | L1 A2V (CH2)3, bonded to +P
RESI R59    -2.00000
GROU
ATOM L1   A2V     0.00
ATOM L2   A5M     0.00
GROU
ATOM A01  M07     0.00
ATOM A02  M07     0.00
ATOM A03  C3E     0.00
ATOM A04  A2V     0.00
ATOM A05  M03     0.00
GROU
ATOM A06  XAR     0.00
ATOM A07  XAR     0.00
ATOM A08  XAR     0.00
ATOM A09  QaD    -1.00
GROU
ATOM A10  XAN     0.00
ATOM A11  XAR     0.00
ATOM A12  A2Y     0.00
ATOM A13  MSO    -1.00
ATOM A14  A2V     0.00
ATOM A15  M06     0.50
ATOM A16  XAR     0.00
ATOM A17  XAR     0.00
ATOM A18  XAR     0.00
ATOM A19  M06     0.50
ATOM A20  A2V     0.00
ATOM A21  A2Y     0.00
ATOM A22  MSO    -1.00
ATOM A23  XAR     0.00
BOND L1   +P        L1   L2        L2   A01
! dye: succinimide ring, linker, phenyl ring (as RESI A59)
BOND A01  A02       A01  A03       A02  A03       A03  A04
BOND A04  A05       A05  A06       A06  A07       A06  A08       A07  A08
BOND A07  A09       A08  A10
BOND A10  A11       A11  A16       A16  A17       A17  A18       A18  A23
BOND A23  A10       A10  A17       A11  A17       A23  A17
BOND A11  A12       A12  A14       A14  A15       A15  A16       A12  A16
BOND A14  A16       A12  A13
BOND A23  A21       A21  A20       A20  A19       A19  A18       A21  A18
BOND A20  A18       A21  A22
! RNA segments get no automatic angles/dihedrals: junction terms + the A59 linker terms (CB -> L2)
ANGL L1   +P   +C1       L2   L1   +P        L1   L2   A01       L2   A01  A02
ANGL A02  A03  A04       A03  A04  A05       A04  A05  A06       A05  A06  A08
DIHE L1   +P   +C1  +C2       L2   L1   +P   +C1       L1   L2   A01  A02
DIHE L2   A01  A02  A03       A01  A02  A03  A04       A01  A03  A04  A05
DIHE A03  A04  A05  A06       A04  A05  A06  A08       A05  A06  A08  A07

!## 3'-Alexa Fluor 488 on RNA: dye-C(=O)NH-CH2-CH2-O-CH2-CH(OH)-CH(-O3') on the last nucleotide.
!## A05-A18 are the beads of RESI A48 (same types, charges and dye bonds); the linker is
!##   L1 M05 CH(OH)-CH-O3' (O3' of the last nucleotide, as in the iConRNA P bead), bonded to -C1
!##   L2 P1T CH2-O-CH2 | A05 M03 CH2-NH-C(=O)
RESI R48    -2.00000
GROU
ATOM L1   M05     0.00
ATOM L2   P1T     0.00
ATOM A05  M03     0.00
GROU
ATOM A06  XAR     0.00
ATOM A07  XAR     0.00
ATOM A08  XAR     0.00
ATOM A09  QaD    -1.00
GROU
ATOM A11  XAN     0.00
ATOM A12  XAR     0.00
ATOM A13  P1W     0.50
ATOM A14  MSO    -1.00
ATOM A15  XAR     0.00
ATOM A16  P1W     0.50
ATOM A17  MSO    -1.00
ATOM A18  XAR     0.00
BOND -C1  L1        L1   L2        L2   A05
! dye: phenyl ring and xanthene (as RESI A48)
BOND A05  A06       A06  A07       A06  A08       A07  A08
BOND A07  A09       A08  A11
BOND A11  A12       A12  A13       A13  A14       A14  A15       A11  A15
BOND A12  A15       A13  A15
BOND A11  A18       A18  A16       A16  A17       A17  A15       A18  A15
BOND A16  A15
! RNA segments get no automatic angles/dihedrals: junction terms + the A48 linker terms
ANGL -P   -C1  L1        -C2  -C1  L1        -C1  L1   L2        L1   L2   A05
ANGL L2   A05  A06       A05  A06  A08
DIHE -P   -C1  L1   L2        -C1  L1   L2   A05       L1   L2   A05  A06
DIHE L2   A05  A06  A08       A05  A06  A08  A07

END
