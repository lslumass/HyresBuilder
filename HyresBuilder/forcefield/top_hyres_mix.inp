* topology file for HyRes_iCon mix model
* 
*
   20    1              
MASS     1 H     25.008   ! amide H in backbone
MASS    31 N     24.007   ! backbone N (Pro)
MASS    38 NH1   24.007   ! backbone N (non-Pro)
MASS    11 C     22.011   ! carbonyl C in backbone
MASS    51 O     25.999   ! carbonyl O in backbone
MASS    12 C1E   23.019   ! CA in backbone (non-Gly)
MASS    13 C2E   24.027   ! CA in backbone (Gly)
MASS    14 C3E   25.035   ! CH3 in Ala, and capping group
MASS    10 CT    22.011   ! aliphatic carbon
MASS   209 A2V   43.089   ! Val side chain
MASS   210 A1L   57.116   ! Leu side chain
MASS   211 A1I   57.116   ! Ile side chain
MASS   212 A5M   75.149   ! Met side chain
MASS   213 P5N   58.060   ! Asn side chain
MASS   214 QaD   58.036   ! Asp side chain
MASS   215 P4Q   72.087   ! Gln side chain
MASS   216 QaE   72.063   ! Glu side chain
MASS   217 P1C   47.095   ! Cys side chain
MASS   218 P1S   31.034   ! Ser side chain
MASS   219 P1T   45.061   ! Thr side chain
MASS   220 A2P   42.081   ! Pro side chain 
MASS   221 A3K   42.081   ! Lys side chain 1 CB
MASS   222 QdK   31.058   ! Lys side chain 2 CC
MASS   223 A3R   42.081   ! Arg side chain 1 CB
MASS   224 QdR   59.072   ! Arg side chain 2 CC
MASS   225 A4H   26.038   ! His side chain 1 CB
MASS   226 P1H   27.026   ! His side chain 2 CC
MASS   227 P2H   28.034   ! His side chain 3 CD
MASS   228 A1F   39.057   ! Phe side chain 1 CB
MASS   229 A2F   26.038   ! Phe side chain 2 CC
MASS   230 A3F   26.038   ! Phe side chain 3 CD
MASS   231 A1Y   39.057   ! Tyr side chain 1 CB
MASS   232 A2Y   26.038   ! Tyr side chain 2 CC
MASS   233 P1Y   42.037   ! Tyr side chain 3 CD
MASS   234 A1W   26.038   ! Trp side chain 1 CB
MASS   235 P1W   28.034   ! Trp side chain 2 CC
MASS   236 A2W   24.022   ! Trp side chain 3 CD
MASS   237 A3W   26.038   ! Trp side chain 4 CE
MASS   238 A4W   26.038   ! Trp side chain 5 CF
!## new type for phosphorylated SER and THR
!## pSER
MASS   239 P2S   14.027   ! pSer side chain 1 CB
MASS   240 P3S   94.970   ! legacy pSer phosphate, kept only for PSFs built before PO3
!## pTHR
MASS   241 P2T   27.046   ! pThr side chain 1 CB
MASS   242 P3T   94.970   ! legacy pThr phosphate, kept only for PSFs built before PO3
!## phosphate group of pSER and pTHR
MASS   243 PO3   94.970   ! phosphate bead (-O-PO3 2-), shared by pSer, pThr (CC) and pTyr (CE)
!## dye xanthene centre (A48 A11, A59 A10); own type so stacking can be set by NBFIX
MASS   244 XAN   36.033   ! xanthene C9 + C8a + C9a (C3)


DECL -C
DECL -O
DECL +N
DECL +H
DECL +CA
DECL +EO
DECL -EO

