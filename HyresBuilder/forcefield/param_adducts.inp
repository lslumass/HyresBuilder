* HyRes parameters for adducts and modified residues (dyes on Cys / RNA ends)
* use with param_hyres_mix.inp and param_metabolome.inp; companion of top_adducts.inp
*

BOND
!
!V(bond) = Kb(b - b0)**2
!
!Kb: kcal/mole/A**2
!b0: A
!
!atom type    Kb      b0
!## A48/A59 linker
P1C   M07      9.81    2.777  ! CB-A01
M07   M07    495.82    2.899  ! A01-A02
C3E   M07    258.97    2.300  ! A01-A03, A02-A03
A2V   C3E      8.78    2.959  ! A03-A04
A2V   M03      2.78    3.628  ! A04-A05
M03   XAR    267.79    2.700  ! A05-A06 (rigid)
!## A48/A59/R48/R59 rigid core: placeholders
XAR   XAR      0.00    1.000
XAN   XAR      0.00    1.000
QAD   XAR      0.00    1.000
QDK   XAR      0.00    1.000
MSO   QDK      0.00    1.000
MSO   XAR      0.00    1.000
A2V   XAR      0.00    1.000
!## R59/R48 junction
A2V   RP      12.22    3.577  ! R59 A01-+P
A2V   A5M      2.31    4.479  ! R59 A01-A02
A5M   M07      2.70    3.432  ! R59 A02-A03
RS1   M05      1.61    3.608  ! R48 -C1-A01
M05   P1T      8.43    2.902  ! R48 A01-A02
P1T   M03      2.95    3.444  ! R48 A02-A03
!## C3B/C66 linker
M3L   XAC     16.46    3.101  ! C3B A04-A05
C3E   M3L      3.16    2.972  ! C3B/C66 A03-A04
M3L   A5L      3.31    3.545  ! C66 A04-A05
A5L   P1H      5.54    3.578  ! C66 A05-A06
P1H   A3R      6.78    2.853  ! C66 A08-A09
A3R   MSO     46.76    3.049  ! C66 A09-A10
!## C3B/C66 rigid core: placeholders
P1T   XAC      0.00    1.000
XAC   XAC      0.00    1.000
XAC   XAN      0.00    1.000
A2V   XAC      0.00    1.000
MSO   XAC      0.00    1.000
XAF   XAF      0.00    1.000
XAF   XAN      0.00    1.000
XAF   XAR      0.00    1.000
MSO   XAF      0.00    1.000
!## dye N(+) beads in the C3B/C66 rigid cores: placeholders (P1H-P1H, A4H-P1H from the HyRes files)
P1H   XAC      0.00    1.000
P1H   A2V      0.00    1.000
P1H   C3E      0.00    1.000
P1H   XAN      0.00    1.000
P1H   XAF      0.00    1.000
XQN   XAR      0.00    1.000
XQN   XAF      0.00    1.000

THETAS
!
!V(angle) = Ktheta(Theta - Theta0)**2
!
!Ktheta: kcal/mole/rad**2
!Theta0: degrees
!
!atom types     Ktheta    Theta0
!## A48/A59 linker
P1C   M07   M07     17.23     92.1  ! CB-A01-A02
M07   C3E   A2V      4.07    128.7  ! A02-A03-A04
C3E   A2V   M03      1.27    162.2  ! A03-A04-A05
A2V   M03   XAR      3.19    129.1  ! A04-A05-A06
M03   XAR   XAR      9.97    172.2  ! A05-A06-A08 (rigid)
!## R59/R48 junction
A2V   RP    RS1      3.85    104.5  ! R59 A01-+P-+C1
A5M   A2V   RP       0.94    150.4  ! R59 A02-A01-+P
A2V   A5M   M07      1.45    163.7  ! R59 A01-A02-A03
A5M   M07   M07      3.35    104.2  ! R59 A02-A03-A04
RP    RS1   M05      1.68    130.5  ! R48 -P--C1-A01
RS2   RS1   M05      2.50    100.6  ! R48 -C2--C1-A01
RS1   M05   P1T      2.77    110.4  ! R48 -C1-A01-A02
M05   P1T   M03      2.75    122.8  ! R48 A01-A02-A03
P1T   M03   XAR      1.55    134.3  ! R48 A02-A03-A04
!## C3B/C66 linker
C3E   M3L   XAC      1.77    141.5  ! C3B A03-A04-A05
M3L   XAC   XAC      4.49    116.0  ! C3B A04-A05-A06
M07   C3E   M3L      1.80    118.9  ! C3B/C66 A02-A03-A04
C3E   M3L   A5L      1.20    150.1  ! C66 A03-A04-A05
M3L   A5L   P1H      1.35    160.4  ! C66 A04-A05-A06
A5L   P1H   A4H      3.90    129.8  ! C66 A05-A06-A07
A4H   P1H   A3R     23.59    105.1  ! C66 A07-A08-A09
P1H   A3R   MSO      5.75    148.9  ! C66 A08-A09-A10

PHI
!
!V(dihedral) = Kchi(1 + cos(n(chi) - delta))
!
!Kchi: kcal/mole
!n: multiplicity
!delta: degrees
!
!atom types             Kchi    n   delta
!## A48/A59 linker
P1C   M07   M07   C3E    15.548   1   -31.8  ! CB-A01-A02-A03
M07   M07   C3E   A2V     0.909   1     7.7  ! A01-A02-A03-A04
M07   M07   C3E   A2V     1.160   3   184.4
A2V   M03   XAR   XAR     1.181   1     0.6  ! A04-A05-A06-A08
M03   XAR   XAR   XAR    11.916   1   177.3  ! A05-A06-A08-A07 (rigid)
M03   XAR   XAR   XAR     3.023   2   -10.0
M03   XAR   XAR   XAR     0.231   3   132.8
!## R59/R48 junction
A2V   RP    RS1   RS2     1.226  1   -173.5  ! R59 A01-+P-+C1-+C2
A2V   RP    RS1   RS2     0.474  3    -48.4
A5M   A2V   RP    RS1     0.550  1    203.9  ! R59 A02-A01-+P-+C1
A5M   A2V   RP    RS1     0.437  2   -222.2
A2V   A5M   M07   M07     0.568  1    -15.8  ! R59 A01-A02-A03-A04
A5M   M07   M07   C3E     7.482  1    -27.3  ! R59 A02-A03-A04-A05
RP    RS1   M05   P1T     0.909  1      8.8  ! R48 -P--C1-A01-A02
RP    RS1   M05   P1T     0.508  2     22.3
RS1   M05   P1T   M03     1.455  1   -178.1  ! R48 -C1-A01-A02-A03
M05   P1T   M03   XAR     2.651  1   -126.7  ! R48 A01-A02-A03-A04
P1T   M03   XAR   XAR     0.894  1     23.8  ! R48 A02-A03-A04-A06
!## C3B/C66 linker
M3L   XAC   XAC   XAC     1.103  1     -4.0  ! C3B A04-A05-A06-A07
M07   M07   C3E   M3L     1.011  2      0.6  ! C3B/C66 A01-A02-A03-A04
P1H   A4H   P1H   A5L     0.945  1     -1.5  ! C66 A08-A07-A06-A05
P1H   A4H   P1H   A3R     3.567  1     -0.7  ! C66 A06-A07-A08-A09
A4H   P1H   A3R   MSO     0.937  2      1.4  ! C66 A07-A08-A09-A10

IMPHI
!
!V(improper) = Kpsi(psi - psi0)**2
!
!Kpsi: kcal/mole/rad**2
!psi0: degrees
!
!atom types           Kpsi                   psi0

NONBONDED  NBXMOD 5  ATOM CDIEL SWITCH VATOM VDISTANCE VSWITCH -
     CUTNB 12.0  CTOFNB 12.0  CTONNB 11.0

!
!V(Lennard-Jones) = Eps,i,j[(Rmin,i,j/ri,j)**12 - 2(Rmin,i,j/ri,j)**6]
!
!epsilon: kcal/mole, Eps,i,j = sqrt(eps,i * eps,j)
!Rmin/2: A, Rmin,i,j = Rmin/2,i + Rmin/2,j
!
!atom  ignored    epsilon      Rmin/2   ignored   eps,1-4       Rmin/2,1-4
!
XAN      0.00     -0.1500      2.3444   0.00     -0.1500       2.3444 ! xanthene centre
XAR      0.00     -0.1500      2.3444   0.00     -0.1500       2.3444 ! dye aromatic ring
XAC      0.00     -0.0900      2.3444   0.00     -0.0900       2.3444 ! Cy3B aromatic ring
XAF      0.00     -0.0900      2.3444   0.00     -0.0900       2.3444 ! CF660R aromatic ring
XQN      0.00     -0.0150      2.7541   0.00     -0.0150       2.7541 ! CF660R N(+)-ethyl (QdK eps, A2V size, no cation-pi)
M3L      0.00     -0.0720      2.2759   0.00     -0.0720       2.2759 ! C2R linker amide
A5L      0.00     -0.1501      2.7541   0.00     -0.1501       2.7541 ! CF660R butyl
A3S      0.00     -0.1001      2.7541   0.00     -0.1001       2.7541 ! legacy, unused

NBFIX
!                 Emin         Rmin
!                 (kcal/mol)   (A)
!# xanthene stacking with aromatic residues and Arg
XAN       A2W      -0.4000      4.4314
XAN       P1Y      -0.3700      4.7968
XAN       A1F      -0.2000      4.9858
XAN       QdR      -0.6000      4.8807
!# xanthene stacking with RNA bases
XAN       RA1      -0.3300      4.5000
XAN       RG1      -0.3700      4.5000
XAN       RC1      -0.2500      4.5000
XAN       RU1      -0.2000      4.5000


END
